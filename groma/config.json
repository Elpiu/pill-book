{
  "exclude": [
    "/generator/tests/",
    "/web/tests/",
    "/web/scripts/",
    "/web/vitest.config.ts",
    "/web/eslint.config.mjs",
    "/web/app/types/bookpack.ts",
    "/samples/"
  ],
  "scanners": [
    {
      "id": "javascript",
      "source": "@groma/scanner-javascript@0.2.3",
      "include": [
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.min.js",
        "*.min.mjs",
        "*.min.cjs",
        "*.min.jsx",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "python",
      "source": "@groma/scanner-python@0.2.3",
      "include": [
        "**/*.py",
        "**/pyproject.toml",
        "**/setup.cfg",
        "**/requirements.txt"
      ],
      "exclude": [
        ".venv/",
        "venv/",
        "__pycache__/",
        "test/",
        "tests/",
        "test_*.py",
        "*_test.py",
        "conftest.py",
        "build/",
        "dist/"
      ]
    },
    {
      "id": "typescript",
      "source": "@groma/scanner-typescript@0.2.4",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "vue",
      "source": "@groma/scanner-vue@0.2.5",
      "include": [
        "**/*.vue",
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        "**/*.cts",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.html",
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.styl",
        "**/tsconfig*.json",
        "**/package.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    }
  ],
  "workSources": []
}
