# Copia in .env (è in gitignore). Non committare mai le chiavi.

# Chiave da https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Qualsiasi modello del catalogo: https://openrouter.ai/models oppure `uv run bookpack models`
BOOKPACK_MODEL=anthropic/claude-sonnet-5.5

# Opzionali
# Chiamate all'LLM insieme: da abbassare se il provider limita le richieste
# BOOKPACK_WORKERS=4
# Sopra questa soglia di token un capitolo viene diviso in parti
# BOOKPACK_CONTEXT_TOKENS=40000
# BOOKPACK_CACHE_DIR=.bookpack-cache
